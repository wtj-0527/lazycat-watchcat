{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "WatchCat Fleet Monitoring V1",
    "theme": "desktop-light",
    "referenceCanvas": {
      "width": 1440,
      "height": 1024
    },
    "note": "Penpot visual baseline; Dark Mode and formal Mobile variants are not included."
  },
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "#f8fafc" },
      "card": { "$type": "color", "$value": "#ffffff" },
      "sidebar": { "$type": "color", "$value": "#0b1220" },
      "sidebarRaised": { "$type": "color", "$value": "#111c2e" },
      "subtle": { "$type": "color", "$value": "#edf2f7" },
      "selected": { "$type": "color", "$value": "#dbeafe" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#0f172a" },
      "secondary": { "$type": "color", "$value": "#475569" },
      "muted": { "$type": "color", "$value": "#64748b" },
      "disabled": { "$type": "color", "$value": "#94a3b8" },
      "inverse": { "$type": "color", "$value": "#ffffff" },
      "sidebar": { "$type": "color", "$value": "#cbd5e1" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#e2e8f0" },
      "subtle": { "$type": "color", "$value": "#edf2f7" },
      "strong": { "$type": "color", "$value": "#cbd5e1" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#2563eb" },
      "soft": { "$type": "color", "$value": "#dbeafe" },
      "accent": { "$type": "color", "$value": "#7c3aed" },
      "accentSoft": { "$type": "color", "$value": "#eef2ff" }
    },
    "status": {
      "healthy": { "$type": "color", "$value": "#15803d" },
      "healthySoft": { "$type": "color", "$value": "#dcfce7" },
      "warning": { "$type": "color", "$value": "#b45309" },
      "warningSoft": { "$type": "color", "$value": "#fef3c7" },
      "critical": { "$type": "color", "$value": "#b91c1c" },
      "criticalSoft": { "$type": "color", "$value": "#fee2e2" },
      "unknown": { "$type": "color", "$value": "#64748b" },
      "unknownSoft": { "$type": "color", "$value": "#e2e8f0" },
      "offline": { "$type": "color", "$value": "#475569" },
      "offlineSoft": { "$type": "color", "$value": "#edf2f7" }
    },
    "chart": {
      "series1": { "$type": "color", "$value": "#2563eb" },
      "series2": { "$type": "color", "$value": "#0891b2" },
      "series3": { "$type": "color", "$value": "#7c3aed" },
      "series4": { "$type": "color", "$value": "#a855f7" },
      "other": { "$type": "color", "$value": "#94a3b8" },
      "grid": { "$type": "color", "$value": "#e8eef6" }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Noto Sans SC",
          "Inter",
          "PingFang SC",
          "Microsoft YaHei",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "10": { "$type": "dimension", "$value": "10px" },
      "11": { "$type": "dimension", "$value": "11px" },
      "12": { "$type": "dimension", "$value": "12px" },
      "13": { "$type": "dimension", "$value": "13px" },
      "14": { "$type": "dimension", "$value": "14px" },
      "15": { "$type": "dimension", "$value": "15px" },
      "16": { "$type": "dimension", "$value": "16px" },
      "18": { "$type": "dimension", "$value": "18px" },
      "20": { "$type": "dimension", "$value": "20px" },
      "28": { "$type": "dimension", "$value": "28px" }
    },
    "lineHeight": {
      "compact": { "$type": "number", "$value": 1.2 },
      "body": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.65 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "card": { "$type": "dimension", "$value": "18px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "contentX": { "$type": "dimension", "$value": "40px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "6px" },
    "button": { "$type": "dimension", "$value": "8px" },
    "nav": { "$type": "dimension", "$value": "10px" },
    "logo": { "$type": "dimension", "$value": "11px" },
    "card": { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "dimension", "$value": "14px" }
  },
  "size": {
    "sidebarWidth": { "$type": "dimension", "$value": "224px" },
    "topbarHeight": { "$type": "dimension", "$value": "72px" },
    "navItemHeight": { "$type": "dimension", "$value": "42px" },
    "buttonHeight": { "$type": "dimension", "$value": "36px" },
    "logo": { "$type": "dimension", "$value": "40px" }
  },
  "layout": {
    "gridGap": { "$type": "dimension", "$value": "16px" },
    "statColumns": { "$type": "number", "$value": 6 },
    "contentRatio": { "$type": "string", "$value": "2:1" },
    "detailRatio": { "$type": "string", "$value": "1.25:0.75" },
    "breakpointCompact": { "$type": "dimension", "$value": "1000px" },
    "breakpointNarrow": { "$type": "dimension", "$value": "720px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "#0f172a08",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  }
}
